# Environment file for docker-compose
# Copy to .env and update values as needed

# Database
DB_ROOT_PASSWORD=rootpassword
DB_NAME=sj_gso_inventory
DB_USER=app
DB_PASSWORD=apppassword
DB_PORT=3306

# Backend
BACKEND_PORT=8080
SPRING_PROFILE=prod
# 'validate' fails at startup: entity IDs are Java Long but the schema uses INT
# columns everywhere (not BIGINT), which strict validation rejects. 'update' is
# what local dev has always run against successfully — same tolerant behavior.
HIBERNATE_DDL=update
# AI Insight tab (asset lifecycle recommendations) — get a free key at
# aistudio.google.com/apikey. Leave blank to keep AI features disabled.
GEMINI_API_KEY=

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
